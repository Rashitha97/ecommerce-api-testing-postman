    {
      "name": "Login API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// use collection runner ",
              "",
              "// Check status code",
              "const expectedStatus = Number(",
              "    pm.iterationData.get(\"expected_status\")",
              ");",
              "",
              "pm.test(\"Status code is correct\", function () {",
              "    pm.expect(pm.response.code).to.eql(expectedStatus);",
              "});",
              "",
              "// Only validate and save token for successful login",
              "if (pm.response.code === 200) {",
              "",
              "    const jsonData = pm.response.json();",
              "",
              "    pm.test(\"Access token exists\", function () {",
              "        pm.expect(jsonData).to.have.property(\"accessToken\");",
              "        pm.expect(jsonData.accessToken).to.be.a(\"string\");",
              "        pm.expect(jsonData.accessToken).to.not.be.empty;",
              "    });",
              "    ",
              "    // Save token, user id and username for subsequent requests",
              "        pm.environment.set(\"token\", jsonData.accessToken);",
              "        pm.environment.set(\"user_id\", jsonData.id);",
              "        pm.environment.set(\"username\", jsonData.username);",
              "",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get User Profile - Positive",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// verify the response status code is 200",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// verify the response body contains the correct user information",
              "const json = pm.response.json();",
              "",
              "pm.test(\"User ID is valid\", function () {",
              "    pm.expect(json.id).to.be.a(\"number\");",
              "    pm.expect(json.id).to.be.above(0);",
              "});",
              "",
              "pm.test(\"User ID matches logged-in user\", function () {",
              "    const expectedUserId = Number(pm.environment.get(\"user_id\"));",
              "    pm.expect(json.id).to.eql(expectedUserId);",
              "});",
              "",
              "pm.test(\"Username matches logged-in user\", function () {",
              "    const expectedUsername = pm.environment.get(\"username\");",
              "    pm.expect(json.username).to.eql(expectedUsername);",
              "});",
              "",
              "pm.test(\"Response has required user fields\", function () {",
              "    pm.expect(json).to.have.property(\"id\");",
              "    pm.expect(json).to.have.property(\"username\");",
              "    pm.expect(json).to.have.property(\"email\");",
              "    pm.expect(json).to.have.property(\"firstName\");",
              "    pm.expect(json).to.have.property(\"lastName\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
