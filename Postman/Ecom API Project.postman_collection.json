    {
      "name": "Get Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = pm.response.json();",
              "",
              "// Set the productId environment variable to the first product's id",
              "pm.environment.set(\"productId\", jsonData.products[0].id);",
              "",
              "// verify the response status code is 200",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// verify response is not empty",
              "pm.test(\"Response is not empty\", function () {",
              "    pm.expect(jsonData).to.not.be.empty;",
              "});",
              "",
              "// verify response contains product details",
              "pm.test(\"Response contains product details\", function () {",
              "    pm.expect(jsonData).to.have.property('products');",
              "    pm.expect(jsonData.products).to.be.an('array').that.is.not.empty;",
              "    pm.expect(jsonData.products[0]).to.have.property('id');",
              "    pm.expect(jsonData.products[0]).to.have.property('title');",
              "    pm.expect(jsonData.products[0]).to.have.property('price');",
              "    pm.expect(jsonData.products[0]).to.have.property('description');",
              "});",
              "",
              "// verify the response contains the products array.",
              "pm.test(\"Response contains products array\", function () {",
              "    pm.expect(jsonData.products).to.be.an(\"array\");",
              "});",
              "",
              "// verify product IDs are positive numbers and are numbers.",
              "pm.test(\"Product IDs are positive numbers\", function () {",
              "    jsonData.products.forEach(product => {",
              "        pm.expect(product.id).to.be.a(\"number\");",
              "        pm.expect(product.id).to.be.above(0);",
              "    });",
              "});",
              "",
              "// verify that product ids are unique.",
              "pm.test(\"Product IDs are unique\", function () {",
              "",
              "    const ids = jsonData.products.map(product => product.id);",
              "    const uniqueIds = [...new Set(ids)];",
              "",
              "    pm.expect(uniqueIds.length).to.eql(ids.length);",
              "});",
              "",
              "// verify product prices are valid numbers and greater than 0",
              "pm.test(\"Product prices are valid\", function () {",
              "    jsonData.products.forEach(product => {",
              "        pm.expect(product.price).to.be.a(\"number\");",
              "        pm.expect(product.price).to.be.above(0);",
              "    });",
              "});",
              "",
              "// verify product title is not empty and is a string.",
              "pm.test(\"Product titles are not empty\", function () {",
              "    jsonData.products.forEach(product => {",
              "        pm.expect(product.title).to.be.a(\"string\");",
              "        pm.expect(product.title).to.not.be.empty;",
              "    });",
              "});",
              "",
              "// verify the response is JSON",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
              "        .to.include(\"application/json\");",
              "});",
              "",
              "// verify the response time less than 1000ms",
              "pm.test(\"Response time is less than 1000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
