    {
      "name": "Add Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// use collection runner",
              "",
              "// Check status code",
              "const expectedStatus = Number(",
              "    pm.iterationData.get(\"expected_status\")",
              ");",
              "",
              "pm.test(\"Status code is correct\", function () {",
              "    pm.expect(pm.response.code).to.eql(expectedStatus);",
              "});",
              "",
              "if (expectedStatus === 201) {",
              "",
              "const jsonData = pm.response.json();",
              "",
              "// verify the cart is not empty",
              "pm.test(\"List is not empty\", function () {",
              "    pm.expect(jsonData.products.length).to.be.above(0);",
              "});",
              "",
              "// verify the cart has an id property and it is a number and greater than 0",
              "pm.test(\"Cart ID is present\", function () {",
              "    pm.expect(jsonData).to.have.property(\"id\");",
              "    pm.expect(jsonData.id).to.be.a(\"number\");",
              "    pm.expect(jsonData.id).to.be.above(0);",
              "});",
              "",
              "pm.environment.set(\"cartId\", jsonData.id);",
              "",
              "// verify appropriate product was added to cart",
              "const requestedProductId = Number(pm.iterationData.get(\"productId\"));",
              "",
              "pm.test(\"Correct product was added\", function () {",
              "    const product = jsonData.products.find(",
              "        p => p.id === requestedProductId",
              "    );",
              "",
              "    pm.expect(product).to.exist;",
              "});",
              "",
              "// verify correct quantity was added",
              "pm.test(\"Correct quantity was added\", function () {",
              "    const product = jsonData.products.find(",
              "        p => p.id === requestedProductId",
              "    );",
              "",
              "    const expectedQuantity = Number(pm.iterationData.get(\"quantity\"));",
              "    pm.expect(product.quantity).to.eql(expectedQuantity);",
              "});",
              "",
              "// verify price is exist",
              "pm.test(\"Price is exist\", function () {",
              "    const product = jsonData.products.find(",
              "        p => p.id === requestedProductId",
              "    );",
              "",
              "    pm.expect(product).to.have.property(\"price\");",
              "    pm.expect(product.price).to.be.a(\"number\");",
              "});",
              "",
              "// verify total is calculated correctly",
              "pm.test(\"Total is calculated correctly\", function () {",
              "    const product = jsonData.products.find(",
              "        p => p.id === requestedProductId",
              "    );",
              "",
              "    pm.expect(product.total).to.equal(product.quantity*product.price);",
              "});",
              "}",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": {{user_id}},\n    \"products\": [\n        {\n            \"id\": {{productId}},\n            \"quantity\": {{quantity}}\n        }\n    ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/carts/add",
          "host": [
