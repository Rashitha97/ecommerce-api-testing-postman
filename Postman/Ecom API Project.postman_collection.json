    {
      "name": "Get Cart Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let jsonData = pm.response.json();",
              "",
              "pm.test(\"Cart total is more than zero\", function () {",
              "    pm.expect(jsonData.total).to.be.above(0);",
              "});",
              "",
              "// verify userID exists",
              "pm.test(\"User ID is present\", function () {",
              "    pm.expect(jsonData.userId).to.not.be.null;",
              "});",
              "",
              "//verify userID is a number",
              "pm.test(\"User ID is a number\", function () {",
              "    pm.expect(jsonData.userId).to.be.a('number');",
              "});",
              "",
              "// verify cart contains at least one product",
              "pm.test(\"Cart contains at least one product\", function () {",
              "    pm.expect(jsonData.products.length).to.be.at.least(1);",
              "});",
              "",
              "// verify each product has a productId",
              "pm.test(\"Each product has a productId\", function () {",
              "    jsonData.products.forEach(function (product) {",
              "        pm.expect(product.id).to.not.be.null;",
              "    });",
              "});",
              "",
              "// verify each product has a quantity",
              "pm.test(\"Each product has a quantity\", function () {",
              "    jsonData.products.forEach(function (product) {",
              "        pm.expect(product.quantity).to.not.be.null;",
              "    });",
              "});",
              "",
              "// verify each product has a price",
              "pm.test(\"Each product has a price\", function () {",
              "    jsonData.products.forEach(function (product) {",
              "        pm.expect(product.price).to.not.be.null;",
              "    });",
              "});",
              "",
              "// verify price is a number",
              "pm.test(\"Each product price is a number\", function () {",
              "    jsonData.products.forEach(function (product) {",
              "        pm.expect(product.price).to.be.a('number');",
              "    });",
              "});",
              "",
              "// verify that the product total is equal to the product price multiplied by the product quantity",
              "pm.test(\"Each product total is equal to price multiplied by quantity\", function () {jsonData.products.forEach(function (product) {",
              "        pm.expect(product.total).to.eql(product.price*product.quantity);",
              "    });",
              "});",
              "",
              "// verify the cart total is equal to the sum of all products' totals",
              "pm.test(\"Cart total is equal to the sum of all products' totals\", function () {",
              "     const sumOfProductTotals = jsonData.products.reduce(",
              "        (sum, product) => sum + product.total, 0",
              "    );",
              "    pm.expect(jsonData.total).to.eql(sumOfProductTotals);",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
