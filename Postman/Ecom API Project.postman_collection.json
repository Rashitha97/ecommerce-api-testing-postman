              "",
              "    pm.expect(json.id).to.eql(productId);",
              "});",
              "",
              "// verify the product has the required fields",
              "const json = pm.response.json();",
              "",
              "pm.test(\"Product has required fields\", function () {",
              "    pm.expect(json).to.have.property(\"id\");",
              "    pm.expect(json).to.have.property(\"title\");",
              "    pm.expect(json).to.have.property(\"price\");",
              "    pm.expect(json).to.have.property(\"description\");",
              "    pm.expect(json).to.have.property(\"category\");",
              "});",
              "",
              "// verify the product fields have correct data types",
              "pm.test(\"Product fields have correct data types\", function () {",
              "",
              "    pm.expect(json.id).to.be.a(\"number\");",
              "    pm.expect(json.title).to.be.a(\"string\");",
              "    pm.expect(json.price).to.be.a(\"number\");",
              "    pm.expect(json.description).to.be.a(\"string\");",
              "    pm.expect(json.category).to.be.a(\"string\");",
              "",
              "});",
              "",
              "// verify the product price is valid",
              "pm.test(\"Product price is valid\", function () {",
              "    pm.expect(json.price).to.be.a(\"number\");",
              "    pm.expect(json.price).to.be.above(0);",
              "});",
              "}",
              ""
            ],
